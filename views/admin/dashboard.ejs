<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Admin Dashboard</title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Global Styling -->
    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <!-- Admin Dashboard Styling -->
    <link
        rel="stylesheet"
        href="/css/adminStyling/dashboard.css"
    >

</head>


<body>

    <%- include('../partials/admin-navbar') %>


    <main class="admin-dashboard">

        <!-- =========================
             HEADER
             ========================= -->

        <div class="admin-dashboard-header">

            <h1>
                Admin Dashboard
            </h1>

            <p>
                Welcome, Admin! Manage the Campus Lost & Found system from here.
            </p>

        </div>


        <!-- =========================
             STATISTICS
             ========================= -->

        <h2 class="mb-4">
            Statistics
        </h2>


        <div class="row g-4">


            <!-- Total Users -->

            <div class="col-md-6 col-lg-3">

                <div class="admin-stat-card">

                    <h5>
                        Total Users
                    </h5>

                    <p class="stat-number">
                        <%= totalUsers %>
                    </p>

                </div>

            </div>


            <!-- Total Items -->

            <div class="col-md-6 col-lg-3">

                <div class="admin-stat-card">

                    <h5>
                        Total Items
                    </h5>

                    <p class="stat-number">
                        <%= totalItems %>
                    </p>

                </div>

            </div>


            <!-- Total Claims -->

            <div class="col-md-6 col-lg-3">

                <div class="admin-stat-card">

                    <h5>
                        Total Claims
                    </h5>

                    <p class="stat-number">
                        <%= totalClaims %>
                    </p>

                </div>

            </div>


            <!-- Pending Claims -->

            <div class="col-md-6 col-lg-3">

                <div class="admin-stat-card">

                    <h5>
                        Pending Claims
                    </h5>

                    <p class="stat-number">
                        <%= pendingClaims %>
                    </p>

                </div>

            </div>


        </div>


        <!-- =========================
             ADMIN MANAGEMENT
             ========================= -->

        <div class="admin-management">

            <a
                href="/admin/users"
                class="btn btn-dark"
            >
                Manage Users
            </a>


            <a
                href="/admin/items"
                class="btn btn-dark"
            >
                Manage Items
            </a>


            <a
                href="/admin/claims"
                class="btn btn-dark"
            >
                Manage Claims
            </a>

        </div>


        <!-- =========================
             PENDING CLAIMS
             ========================= -->

        <h2 class="mt-5 mb-4">
            Pending Claims
        </h2>


        <a
            href="/admin/claims"
            class="btn btn-dark mb-4"
        >
            View All Claims
        </a>


        <% if (pendingClaimsList.length === 0) { %>


            <div class="admin-pending">

                <p class="text-muted mb-0">
                    There are no pending claims.
                </p>

            </div>


        <% } else { %>


            <div class="admin-pending">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead>

                            <tr>

                                <th>
                                    Item
                                </th>

                                <th>
                                    Claimant
                                </th>

                                <th>
                                    Message
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <% for (const claim of pendingClaimsList) { %>

                                <tr>

                                    <td>
                                        <%= claim.item.title %>
                                    </td>

                                    <td>
                                        <%= claim.claimant.username %>
                                    </td>

                                    <td>
                                        <%= claim.message %>
                                    </td>

                                </tr>

                            <% } %>

                        </tbody>

                    </table>

                </div>

            </div>


        <% } %>


    </main>


    <!-- Bootstrap JavaScript -->

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


</body>

</html>