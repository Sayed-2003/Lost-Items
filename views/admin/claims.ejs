<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Manage Claims</title>


    <!-- Bootstrap -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Bootstrap Icons -->

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
    >

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet"
    >

    <!-- Global Styling -->

    <link
        rel="stylesheet"
        href="/css/style.css"
    >


    <!-- Admin Claims Styling -->

    <link
        rel="stylesheet"
        href="/css/adminStyling/claims.css"
    >

</head>


<body>

    <% const statusIcons = {
        Pending: 'bi-hourglass-split',
        Approved: 'bi-check-circle-fill',
        Rejected: 'bi-x-circle-fill'
    }; %>

    <%- include('../partials/admin-navbar') %>


    <main class="admin-page">


        <!-- =========================
             PAGE HEADER
             ========================= -->

        <div class="admin-page-header">

            <h1>
                <i class="bi bi-file-earmark-text"></i>
                Manage Claims
            </h1>

            <p class="text-muted">
                View all claims submitted by users.
            </p>

        </div>


        <!-- =========================
             BACK BUTTON
             ========================= -->

        <a
            href="/admin/dashboard"
            class="btn btn-dark mb-4"
        >
            <i class="bi bi-arrow-left"></i>
            Back to Dashboard
        </a>


        <!-- =========================
             CLAIMS TABLE
             ========================= -->

        <% if (claims.length === 0) { %>

            <div class="admin-table-container">
                <div class="empty-state">
                    <span class="icon-circle">
                        <i class="bi bi-inbox"></i>
                    </span>
                    <p class="text-muted mb-0">No claims have been submitted yet.</p>
                </div>
            </div>

        <% } else { %>

        <div class="admin-table-container">

            <div class="table-responsive">

                <table class="table admin-table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>
                                <i class="bi bi-box-seam"></i>
                                Item
                            </th>

                            <th>
                                <i class="bi bi-person"></i>
                                Claimant
                            </th>

                            <th>
                                <i class="bi bi-chat-left-text"></i>
                                Message
                            </th>

                            <th>
                                <i class="bi bi-flag"></i>
                                Status
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        <% for (const claim of claims) { %>

                            <tr>


                                <!-- Item -->

                                <td>

                                    <strong>
                                        <%= claim.item.title %>
                                    </strong>

                                </td>


                                <!-- Claimant -->

                                <td>

                                    <%= claim.claimant.username %>

                                </td>


                                <!-- Message -->

                                <td>

                                    <%= claim.message %>

                                </td>


                                <!-- Status -->

                                <td>

                                    <span class="status status-<%= claim.status.toLowerCase() %>">

                                        <i class="bi <%= statusIcons[claim.status] %>"></i>
                                        <%= claim.status %>

                                    </span>

                                </td>


                            </tr>

                        <% } %>

                    </tbody>

                </table>

            </div>

        </div>

        <% } %>


    </main>


    <!-- Bootstrap JavaScript -->

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


</body>

</html>