<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Manage Claims</title>


    <!-- Bootstrap -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >


    <!-- Global Styling -->

    <link
        rel="stylesheet"
        href="/css/style.css"
    >


    <!-- Admin Claims Styling -->

    <link
        rel="stylesheet"
        href="/css/adminStyling/claims.css"
    >

</head>


<body>

    <%- include('../partials/admin-navbar') %>


    <main class="admin-page">


        <!-- =========================
             PAGE HEADER
             ========================= -->

        <div class="admin-page-header">

            <h1>
                Manage Claims
            </h1>

            <p class="text-muted">
                View all claims submitted by users.
            </p>

        </div>


        <!-- =========================
             BACK BUTTON
             ========================= -->

        <a
            href="/admin/dashboard"
            class="btn btn-dark mb-4"
        >
            ← Back to Dashboard
        </a>


        <!-- =========================
             CLAIMS TABLE
             ========================= -->

        <div class="admin-table-container">

            <div class="table-responsive">

                <table class="table admin-table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>
                                Item
                            </th>

                            <th>
                                Claimant
                            </th>

                            <th>
                                Message
                            </th>

                            <th>
                                Status
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        <% for (const claim of claims) { %>

                            <tr>


                                <!-- Item -->

                                <td>

                                    <strong>
                                        <%= claim.item.title %>
                                    </strong>

                                </td>


                                <!-- Claimant -->

                                <td>

                                    <%= claim.claimant.username %>

                                </td>


                                <!-- Message -->

                                <td>

                                    <%= claim.message %>

                                </td>


                                <!-- Status -->

                                <td>

                                    <span class="admin-claim-status">

                                        <%= claim.status %>

                                    </span>

                                </td>


                            </tr>

                        <% } %>

                    </tbody>

                </table>

            </div>

        </div>


    </main>


    <!-- Bootstrap JavaScript -->

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


</body>

</html>