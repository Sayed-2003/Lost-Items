<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Manage Claims</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body>

    <%- include('../partials/admin-navbar.ejs') %>

    <div class="container mt-4">

        <h1 class="mb-4">Manage Claims</h1>

        <a href="/admin/dashboard" class="btn btn-dark mb-4">
            Back to Dashboard
        </a>

        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Claimant</th>
                        <th>Message</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>

                    <% for (const claim of claims) { %>

                        <tr>

                            <td>
                                <%= claim.item.title %>
                            </td>

                            <td>
                                <%= claim.claimant.username %>
                            </td>

                            <td>
                                <%= claim.message %>
                            </td>

                            <td>
                                <%= claim.status %>
                            </td>

                        </tr>

                    <% } %>

                </tbody>

            </table>

        </div>

    </div>

</body>

</html>