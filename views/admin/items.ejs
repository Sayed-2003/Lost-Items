<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Manage Items</title>


    <!-- Bootstrap -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Bootstrap Icons -->

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
    >

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet"
    >

    <!-- Global Styling -->

    <link
        rel="stylesheet"
        href="/css/style.css"
    >


    <!-- Admin Items Styling -->

    <link
        rel="stylesheet"
        href="/css/adminStyling/items.css"
    >

</head>


<body>

    <% const categoryIcons = {
        Electronics: 'bi-laptop',
        Clothing: 'bi-bag',
        Documents: 'bi-file-earmark-text',
        Accessories: 'bi-watch',
        Other: 'bi-box-seam'
    }; %>

    <%- include('../partials/admin-navbar') %>


    <main class="admin-page">


        <!-- =========================
             PAGE HEADER
             ========================= -->

        <div class="admin-page-header">

            <h1>
                <i class="bi bi-box-seam"></i>
                Manage Items
            </h1>

            <p class="text-muted">
                View all lost and found items submitted to the system.
            </p>

        </div>


        <!-- =========================
             BACK BUTTON
             ========================= -->

        <a
            href="/admin/dashboard"
            class="btn btn-dark mb-4"
        >
            <i class="bi bi-arrow-left"></i>
            Back to Dashboard
        </a>


        <!-- =========================
             ITEMS TABLE
             ========================= -->

        <% if (items.length === 0) { %>

            <div class="admin-table-container">
                <div class="empty-state">
                    <span class="icon-circle">
                        <i class="bi bi-inbox"></i>
                    </span>
                    <p class="text-muted mb-0">No items have been submitted yet.</p>
                </div>
            </div>

        <% } else { %>

        <div class="admin-table-container">

            <div class="table-responsive">

                <table class="table admin-table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>
                                <i class="bi bi-tag"></i>
                                Title
                            </th>

                            <th>
                                <i class="bi bi-arrow-left-right"></i>
                                Type
                            </th>

                            <th>
                                <i class="bi bi-grid"></i>
                                Category
                            </th>

                            <th>
                                <i class="bi bi-geo-alt"></i>
                                Location
                            </th>

                            <th>
                                <i class="bi bi-person"></i>
                                Owner
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        <% for (const item of items) { %>

                            <tr>


                                <!-- Title -->

                                <td>

                                    <strong>
                                        <%= item.title %>
                                    </strong>

                                </td>


                                <!-- Type -->

                                <td>

                                    <span class="pill-badge <%= item.type === 'Lost' ? 'badge-lost' : 'badge-found' %>">

                                        <i class="bi <%= item.type === 'Lost' ? 'bi-search' : 'bi-box-seam' %>"></i>
                                        <%= item.type %>

                                    </span>

                                </td>


                                <!-- Category -->

                                <td>

                                    <span class="category-chip">
                                        <i class="bi <%= categoryIcons[item.category] || 'bi-box-seam' %>"></i>
                                        <%= item.category %>
                                    </span>

                                </td>


                                <!-- Location -->

                                <td>

                                    <%= item.location %>

                                </td>


                                <!-- Owner -->

                                <td>

                                    <%= item.owner.username %>

                                </td>


                            </tr>

                        <% } %>

                    </tbody>

                </table>

            </div>

        </div>

        <% } %>


    </main>


    <!-- Bootstrap JavaScript -->

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


</body>

</html>