<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Manage Items</title>


    <!-- Bootstrap -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >


    <!-- Global Styling -->

    <link
        rel="stylesheet"
        href="/css/style.css"
    >


    <!-- Admin Items Styling -->

    <link
        rel="stylesheet"
        href="/css/adminStyling/items.css"
    >

</head>


<body>

    <%- include('../partials/admin-navbar') %>


    <main class="admin-page">


        <!-- =========================
             PAGE HEADER
             ========================= -->

        <div class="admin-page-header">

            <h1>
                Manage Items
            </h1>

            <p class="text-muted">
                View all lost and found items submitted to the system.
            </p>

        </div>


        <!-- =========================
             BACK BUTTON
             ========================= -->

        <a
            href="/admin/dashboard"
            class="btn btn-dark mb-4"
        >
            ← Back to Dashboard
        </a>


        <!-- =========================
             ITEMS TABLE
             ========================= -->

        <div class="admin-table-container">

            <div class="table-responsive">

                <table class="table admin-table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>
                                Title
                            </th>

                            <th>
                                Type
                            </th>

                            <th>
                                Category
                            </th>

                            <th>
                                Location
                            </th>

                            <th>
                                Owner
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        <% for (const item of items) { %>

                            <tr>


                                <!-- Title -->

                                <td>

                                    <strong>
                                        <%= item.title %>
                                    </strong>

                                </td>


                                <!-- Type -->

                                <td>

                                    <span class="admin-item-type">

                                        <%= item.type %>

                                    </span>

                                </td>


                                <!-- Category -->

                                <td>

                                    <%= item.category %>

                                </td>


                                <!-- Location -->

                                <td>

                                    <%= item.location %>

                                </td>


                                <!-- Owner -->

                                <td>

                                    <%= item.owner.username %>

                                </td>


                            </tr>

                        <% } %>

                    </tbody>

                </table>

            </div>

        </div>


    </main>


    <!-- Bootstrap JavaScript -->

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


</body>

</html>