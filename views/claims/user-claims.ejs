<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Claims</title>
</head>
<body>
    <h1>User Requests</h1>

    
    <% for(const oneClaim of Claim){ %>

    

       <p>Title: <%= oneClaim.item.title %></p> 

       <p>Description: <%= oneClaim.item.description %></p>

       <p>Image: <%= oneClaim.item.image %></p>

        <p>Username: <%= oneClaim.claimant.username %></p>

        <p>Message: <%= oneClaim.message %></p>

        <p>Status: <%= oneClaim.status %></p>

        <form action="/claims/<%= oneClaim._id %>/accept?_method=PUT" method="post">
    <button id="Approved">Approved</button>
</form>

<form action="/claims/<%= oneClaim._id %>/reject?_method=PUT" method="post">
    <button id="rejected">Rejected</button>
</form>

<% } %>     
</body>
</html>