<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>User Claims</title>

<link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
>

<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
    rel="stylesheet"
>

<link rel="stylesheet" href="/css/style.css">

<link
    rel="stylesheet"
    href="/css/claimStyling/user-claims.css"
>

</head>

<body>

    <%- include('../partials/navbar') %>

    <div class="container">

        <div class="claims-page-header">
            <span class="icon-circle icon-circle-lg">
                <i class="bi bi-inbox"></i>
            </span>
            <h1>User Requests</h1>
        </div>

        <% if (Claim.length === 0) { %>

            <div class="empty-state">
                <span class="icon-circle icon-circle-lg">
                    <i class="bi bi-check2-circle"></i>
                </span>
                <h5>All caught up</h5>
                <p>You have no pending requests.</p>
            </div>

        <% } else { %>

            <% for (const oneClaim of Claim) { %>

                <div class="claim-card">

                    <h2>
                        <%= oneClaim.item.title %>
                    </h2>

                    <p>
                        <i class="bi bi-card-text"></i>
                        <span><strong>Description:</strong> <%= oneClaim.item.description %></span>
                    </p>

                    <% if (oneClaim.item.image) { %>

                        <img
                            src="<%= oneClaim.item.image %>"
                            alt="<%= oneClaim.item.title %>"
                        >

                    <% } %>

                    <p>
                        <i class="bi bi-person"></i>
                        <span><strong>Username:</strong> <%= oneClaim.claimant.username %></span>
                    </p>

                    <p>
                        <i class="bi bi-chat-left-text"></i>
                        <span><strong>Message:</strong> <%= oneClaim.message %></span>
                    </p>

                    <p>
                        <strong>Status:</strong>
                        <span class="status status-<%= oneClaim.status.toLowerCase() %>">
                            <i class="bi bi-hourglass-split"></i>
                            <%= oneClaim.status %>
                        </span>
                    </p>

                    <div class="claim-actions">

                        <form
                            action="/claims/<%= oneClaim._id %>/accept?_method=PUT"
                            method="post"
                        >

                            <button
                                class="approve-button"
                                type="submit"
                            >
                                <i class="bi bi-check-lg"></i>
                                Approve
                            </button>

                        </form>

                        <form
                            action="/claims/<%= oneClaim._id %>/reject?_method=PUT"
                            method="post"
                        >

                            <button
                                class="reject-button"
                                type="submit"
                            >
                                <i class="bi bi-x-lg"></i>
                                Reject
                            </button>

                        </form>

                    </div>

                </div>

            <% } %>

        <% } %>

    </div>

    <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>

</html>