<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My claims</title>
</head>
<body>
    <%- include('../navbar.ejs') %>
    
    <h1>My Claims</h1>
<% if (Claim.length === 0) { %>

    <h1>You have not submitted any claims.</h1>

<% } else { %>
<% for (const oneClaim of Claim) { %>

    <div>
        <h2>Title:<%= oneClaim.item.title %></h2>
        <p>image: <%= oneClaim.item.image %></p>
        <p>Message: <%= oneClaim.message %></p>
        <p>Status: <%= oneClaim.status %></p>


        <a href="/items/<%= oneClaim.item._id %>">
            View Item
        </a>
    </div>

<% } %>
<% } %>
</body>
</html>