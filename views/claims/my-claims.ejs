<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Claims</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
>

<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
    rel="stylesheet"
>

<link rel="stylesheet" href="/css/style.css">

<link
    rel="stylesheet"
    href="/css/claimStyling/my-claims.css"
>

</head>

<body>

    <% const statusIcons = {
        Pending: 'bi-hourglass-split',
        Approved: 'bi-check-circle-fill',
        Rejected: 'bi-x-circle-fill'
    }; %>

    <%- include('../partials/navbar') %>

    <div class="container">

        <div class="claims-page-header">
            <span class="icon-circle icon-circle-lg">
                <i class="bi bi-bookmark-check"></i>
            </span>
            <h1>My Claims</h1>
        </div>

        <% if (Claim.length === 0) { %>

            <div class="empty-state">
                <span class="icon-circle icon-circle-lg">
                    <i class="bi bi-inbox"></i>
                </span>
                <h5>No claims yet</h5>
                <p>You have not submitted any claims.</p>
                <a href="/items/all-items" class="btn btn-primary">
                    <i class="bi bi-search"></i>
                    Browse Items
                </a>
            </div>

        <% } else { %>

            <% for (const oneClaim of Claim) { %>

                <div class="claim-card">

                    <h2>
                        <%= oneClaim.item.title %>
                    </h2>

                    <% if (oneClaim.item.image) { %>

                        <img
                            src="<%= oneClaim.item.image %>"
                            alt="<%= oneClaim.item.title %>"
                        >

                    <% } %>

                    <p>
                        <i class="bi bi-chat-left-text"></i>
                        <span><strong>Message:</strong> <%= oneClaim.message %></span>
                    </p>

                    <p>
                        <strong>Status:</strong>
                        <span class="status status-<%= oneClaim.status.toLowerCase() %>">
                            <i class="bi <%= statusIcons[oneClaim.status] %>"></i>
                            <%= oneClaim.status %>
                        </span>
                    </p>

                    
                        class="action-link"
                        href="/items/<%= oneClaim.item._id %>"
                    >
                        <i class="bi bi-arrow-right-circle"></i>
                        View Item
                    </a>

                </div>

            <% } %>

        <% } %>

    </div>

    <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>

</html>