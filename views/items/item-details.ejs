<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= item.title %>
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">

    <link rel="stylesheet" href="/css/itemStyling/item-details.css">

</head>

<body>

    <% const categoryIcons={ Electronics: 'bi-laptop' , Clothing: 'bi-bag' , Documents: 'bi-file-earmark-text' ,
        Accessories: 'bi-watch' , Other: 'bi-box-seam' }; %>

        <%- include('../partials/navbar') %>

            <div class="item-details">

                <div class="item-details-top">

                    <span class="pill-badge <%= item.type === 'Lost' ? 'badge-lost' : 'badge-found' %>">
                        <i class="bi <%= item.type === 'Lost' ? 'bi-search' : 'bi-box-seam' %>"></i>
                        <%= item.type %>
                    </span>

                    <h1>
                        <%= item.title %>
                    </h1>

                </div>

                <img src="<%= item.image %>" alt="<%= item.title %>">

                <p>
                    <i class="bi bi-card-text"></i>
                    <span><strong>Description:</strong>
                        <%= item.description %>
                    </span>
                </p>

                <p>
                    <i class="bi <%= categoryIcons[item.category] || 'bi-box-seam' %>"></i>
                    <span><strong>Category:</strong>
                        <%= item.category %>
                    </span>
                </p>

                <p>
                    <i class="bi bi-geo-alt"></i>
                    <span><strong>Location:</strong>
                        <%= item.location %>
                    </span>
                </p>

                <p>
                    <i class="bi bi-calendar3"></i>
                    <span><strong>Date:</strong>
                        <%= item.date.toDateString() %>
                    </span>
                </p>

                <% if (item.owner) { %>

                    <p>
                        <i class="bi bi-person"></i>
                        <span><strong>Posted by:</strong>
                            <%= item.owner.username %>
                        </span>
                    </p>

                    <% } %>

                        <div class="item-details-actions">

                            <% if (item.owner._id.equals(user._id)) { %>

                                <a class="action-link action-link-secondary" href="/items/all-items">
                                    <i class="bi bi-arrow-left"></i>
                                    Back to all items
                                </a>


                                <a class="action-link" href="/items/<%= item._id %>/edit">
                                    <i class="bi bi-pencil-square"></i>
                                    Edit Item
                                </a>

                                <% } %>

                                    <a class="action-link action-link-secondary" href="/items/<%= item._id %>/pdf"
                                        target="_blank">
                                        <i class="bi bi-file-earmark-pdf"></i>
                                        Download PDF
                                    </a>

                        </div>

                        <% if (user && !item.owner._id.equals(user._id)) { %>

                            <% if(isClaimed){ %>

                                <h2>
                                    <i class="bi bi-check-circle-fill"></i>
                                    This item has been claimed
                                </h2>

                                <% }else{ %>

                                    <form action="/claims/create/<%= item._id %>" method="POST">

                                        <label for="message">
                                            <i class="bi bi-chat-left-text"></i>
                                            Why do you think this item belongs to you?
                                        </label>

                                        <input id="message" type="text" name="message" maxlength="500" required>

                                        <button type="submit">
                                            <i class="bi bi-send"></i>
                                            Claim Item
                                        </button>

                                    </form>

                                    <% } %>


                                        <% } %>

            </div>

</body>

</html>