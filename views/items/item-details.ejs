<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= item.title %>
    </title>
</head>

<body>
    <%- include('../partials/navbar') %>

<!-- item details -->
    <h1>
        <%= item.title %>
    </h1>

    <% if (item.image) { %>
        <img src="<%= item.image %>" alt="<%= item.title %>" width="300">
        <% } %>

            <p>
                <strong>Description:</strong>
                <%= item.description %>
            </p>

            <p>
                <strong>Category:</strong>
                <%= item.category %>
            </p>

            <p>
                <strong>Location:</strong>
                <%= item.location %>
            </p>

            <p>
                <strong>Date:</strong>
                <%= item.date.toDateString() %>
            </p>

            <p>
                <strong>Type:</strong>
                <%= item.type %>
            </p>

            <% if (item.owner) { %>
                <p>
                    <strong>Posted by:</strong>
                    <%= item.owner.username %>
                </p>
                <% } %>

                    <% if (item.owner._id.equals(user._id)) { %>
                        <a href="/items/<%= item._id %>/edit">Edit Item</a>
                        <% } %>

                            <a href="/items/all-items">Back to all items</a>

                            <br><br>

                <% if (user && !item.owner._id.equals(user._id)) { %>
<!-- claim form -->
    <form action="/claims/create/<%= item._id %>" method="POST">

        <label for="message"> Why do you think this item belongs to you? </label>

        <input id="message" type="text" name="message" maxlength="500" required >

        <button type="submit">Claim Item</button>
    </form>

<% } %>

</body>

</html>