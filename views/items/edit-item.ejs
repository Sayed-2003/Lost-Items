<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Item</title>

    <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
>

<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
    rel="stylesheet"
>

<link rel="stylesheet" href="/css/style.css">

<link
    rel="stylesheet"
    href="/css/itemStyling/edit-item.css"
>

</head>

<body>

    <%- include('../partials/navbar') %>

    <div class="container">

        <div class="form-header">
            <span class="icon-circle icon-circle-lg">
                <i class="bi bi-pencil-square"></i>
            </span>
            <h1>Edit Item</h1>
        </div>

        <form action="/items/<%= item._id %>?_method=PUT" method="POST" enctype="multipart/form-data">

            <label for="title">
                <i class="bi bi-tag"></i>
                Item Name:
            </label>

            <input
                type="text"
                id="title"
                name="title"
                value="<%= item.title %>"
                required
            >

            <label for="description">
                <i class="bi bi-card-text"></i>
                Description:
            </label>

            <textarea
                id="description"
                name="description"
                required
            ><%= item.description %></textarea>

            <label for="category">
                <i class="bi bi-grid"></i>
                Category:
            </label>

            <select id="category" name="category" required>

                <option value="Electronics" <%= item.category === 'Electronics' ? 'selected' : '' %>>
                    Electronics
                </option>

                <option value="Clothing" <%= item.category === 'Clothing' ? 'selected' : '' %>>
                    Clothing
                </option>

                <option value="Documents" <%= item.category === 'Documents' ? 'selected' : '' %>>
                    Documents
                </option>

                <option value="Accessories" <%= item.category === 'Accessories' ? 'selected' : '' %>>
                    Accessories
                </option>

                <option value="Other" <%= item.category === 'Other' ? 'selected' : '' %>>
                    Other
                </option>

            </select>

            <label for="location">
                <i class="bi bi-geo-alt"></i>
                Location:
            </label>

            <input
                type="text"
                id="location"
                name="location"
                value="<%= item.location %>"
                required
            >

            <label for="date">
                <i class="bi bi-calendar3"></i>
                Date:
            </label>

            <input
                type="date"
                id="date"
                name="date"
                value="<%= item.date.toISOString().split('T')[0] %>"
                required
            >

            <label for="type">
                <i class="bi bi-arrow-left-right"></i>
                Item Type:
            </label>

            <select id="type" name="type" required>

                <option value="Lost" <%= item.type === 'Lost' ? 'selected' : '' %>>
                    Lost
                </option>

                <option value="Found" <%= item.type === 'Found' ? 'selected' : '' %>>
                    Found
                </option>

            </select>

            <p class="original-image-label">
                <i class="bi bi-image"></i>
                Original Image
            </p>

            <img
                src="<%= item.image %>"
                alt="<%= item.title %>"
            >

            <label for="image">
                <i class="bi bi-arrow-repeat"></i>
                Replace Image:
            </label>

            <input
                type="file"
                id="image"
                name="image"
            >

            <button type="submit">
                <i class="bi bi-check2-circle"></i>
                Update Item
            </button>

        </form>

    </div>

</body>

</html>