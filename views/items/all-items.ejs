<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lost & Found Items</title>
</head>

<body>

    <h1>Lost & Found Items</h1>

    <% for (const oneItem of items) { %>

        <div>
            <h2><%= oneItem.title %></h2>

            <p>
                <strong>Description:</strong>
                <%= oneItem.description %>
            </p>

            <p>
                <strong>Category:</strong>
                <%= oneItem.category %>
            </p>

            <p>
                <strong>Location:</strong>
                <%= oneItem.location %>
            </p>

            <p>
                <strong>Date:</strong>
                <%= oneItem.date.toDateString() %>
            </p>

            <p>
                <strong>Type:</strong>
                <%= oneItem.type %>
            </p>

            <% if (oneItem.image) { %>
                <img src="<%= oneItem.image %>" alt="<%= oneItem.title %>" width="200">
            <% } %>

            <br>

            <a href="/items/<%= oneItem._id %>">View Details</a>

                <br><br>
             <form action="/items/<%= oneItem._id %>?_method=DELETE" method="post">
        <button>Delete</button>
    </form>

        </div>

        <hr>

    <% } %>

</body>
</html>